diff --git a/llc/llc-connect.css b/llc/llc-connect.css
new file mode 100644
index 0000000..6d454ee
--- /dev/null
+++ b/llc/llc-connect.css
@@ -0,0 +1,254 @@
+/* ==========================================================================
+   Lasting Legacy Cleaners - Connect layer
+   Sitewide call CTAs, Funeral Home ZIP Locator, Formspree call-back form.
+   Brand: navy #192B3E, gold #C9A85C, light gold #E3C98A, cream #F4F0E8
+   Fonts already loaded by the site: Cormorant Garamond (display), Jost (text)
+   Everything is namespaced .llc-* so it cannot collide with Elementor styles.
+   ========================================================================== */
+
+:root {
+  --llc-navy: #192B3E;
+  --llc-navy-2: #22384f;
+  --llc-gold: #C9A85C;
+  --llc-gold-2: #E3C98A;
+  --llc-gold-ink: #8a6d2c;
+  --llc-cream: #F4F0E8;
+  --llc-paper: #FFFFFF;
+  --llc-ink: #1d2733;
+  --llc-muted: #5f6b78;
+  --llc-line: #e3ddd0;
+  --llc-ok: #1e7e34;
+  --llc-err: #b3261e;
+  --llc-radius: 10px;
+  --llc-shadow: 0 10px 30px rgba(25, 43, 62, 0.18);
+  --llc-font: "Jost", system-ui, -apple-system, "Segoe UI", sans-serif;
+  --llc-display: "Cormorant Garamond", Georgia, serif;
+  --llc-dock-h: 0px;
+}
+
+.llc-root, .llc-root * , .llc-root *::before, .llc-root *::after { box-sizing: border-box; }
+.llc-root { font-family: var(--llc-font); color: var(--llc-ink); line-height: 1.45; }
+.llc-root svg { width: 1em; height: 1em; flex: 0 0 auto; fill: currentColor; }
+.llc-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+
+/* ---------- Buttons (hardened against theme button/link styles) ---------- */
+.llc-root .llc-btn,
+.llc-root a.llc-btn,
+.llc-root button.llc-btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: .55em;
+  font-family: var(--llc-font); font-weight: 700; font-size: 16px; line-height: 1.1;
+  letter-spacing: .03em; text-transform: uppercase; text-decoration: none !important;
+  padding: 15px 24px; border-radius: 6px; border: 2px solid transparent;
+  cursor: pointer; transition: background .15s ease, color .15s ease, border-color .15s ease, transform .15s ease, box-shadow .15s ease;
+  white-space: nowrap; box-shadow: none; min-height: 50px;
+}
+.llc-root .llc-btn:focus-visible { outline: 3px solid var(--llc-gold-2); outline-offset: 2px; }
+.llc-root .llc-btn.llc-btn--gold { background: var(--llc-gold); color: var(--llc-navy); border-color: var(--llc-gold); }
+.llc-root .llc-btn.llc-btn--gold:hover, .llc-root .llc-btn.llc-btn--gold:focus { background: var(--llc-gold-2); border-color: var(--llc-gold-2); color: var(--llc-navy); box-shadow: 0 5px 14px rgba(227,201,138,.35); }
