{
  "redirects": [
    {
      "source": "/app/",
      "destination": "/app",
      "permanent": false
    },
    {
      "source": "/demo/",
      "destination": "/demo",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/llc-funeral-homes",
      "destination": "/api/llc-funeral-homes"
    },
    {
      "source": "/app",
      "destination": "https://llc-portal-web.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://llc-portal-web.vercel.app/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://llc-portal-api.vercel.app/api/:path*"
    },
    {
      "source": "/demo",
      "destination": "https://llc-demo-web.vercel.app/demo"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://llc-demo-web.vercel.app/demo/:path*"
    },
    {
      "source": "/demo-api/:path*",
      "destination": "https://llc-demo-api.vercel.app/api/:path*"
    }
  ]
}
