{
  "redirects": [
    {
      "source": "/app/",
      "destination": "/app",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/llc-funeral-homes",
      "destination": "/api/llc-funeral-homes"
    },
    {
      "source": "/app",
      "destination": "https://legacyfrontend.vercel.app/app"
    },
    {
      "source": "/app/assets/:path*",
      "destination": "https://legacyfrontend.vercel.app/app/assets/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "https://legacyfrontend.vercel.app/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://legacybackend.vercel.app/api/:path*"
    }
  ]
}
