{
  "rewrites": [
    { "source": "/app/assets/:path*", "destination": "https://legacyfrontend.vercel.app/app/assets/:path*" },
    { "source": "/app/:path*", "destination": "https://legacyfrontend.vercel.app/app/:path*" },
    { "source": "/api/:path*", "destination": "https://legacybackend.vercel.app/api/:path*" }
  ]
}